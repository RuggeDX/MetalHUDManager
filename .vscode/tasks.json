{
    // Cmd+Shift+B runs the default task (live dev build).
    // Other tasks: Terminal > Run Task...
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Run dev build (live reload)",
            "detail": "scripts/dev.sh: rebuilds and relaunches on every save",
            "type": "shell",
            "command": "scripts/dev.sh",
            "group": { "kind": "build", "isDefault": true },
            "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
            "problemMatcher": {
                "owner": "swiftc",
                "fileLocation": ["autoDetect", "${workspaceFolder}"],
                "pattern": {
                    "regexp": "^(.*?):(\\d+):(\\d+):\\s+(error|warning):\\s+(.*)$",
                    "file": 1, "line": 2, "column": 3, "severity": 4, "message": 5
                }
            }
        },
        {
            "label": "Run dev build with mock update",
            "detail": "Pretends v9.9.9 is available to preview the update dialog",
            "type": "shell",
            "command": "scripts/dev.sh",
            "options": { "env": { "MHM_MOCK_UPDATE": "1" } },
            "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
            "problemMatcher": {
                "owner": "swiftc",
                "fileLocation": ["autoDetect", "${workspaceFolder}"],
                "pattern": {
                    "regexp": "^(.*?):(\\d+):(\\d+):\\s+(error|warning):\\s+(.*)$",
                    "file": 1, "line": 2, "column": 3, "severity": 4, "message": 5
                }
            }
        },
        {
            "label": "Install release build to /Applications",
            "detail": "scripts/build-app.sh --install, then opens the app",
            "type": "shell",
            "command": "scripts/build-app.sh --install && open '/Applications/Metal HUD Manager.app'",
            "presentation": { "reveal": "always", "panel": "shared", "clear": true },
            "problemMatcher": {
                "owner": "swiftc",
                "fileLocation": ["autoDetect", "${workspaceFolder}"],
                "pattern": {
                    "regexp": "^(.*?):(\\d+):(\\d+):\\s+(error|warning):\\s+(.*)$",
                    "file": 1, "line": 2, "column": 3, "severity": 4, "message": 5
                }
            }
        },
        {
            "label": "Build release DMG",
            "detail": "Universal build + build/MetalHUDManager.dmg",
            "type": "shell",
            "command": "UNIVERSAL=1 scripts/build-app.sh && scripts/make-dmg.sh",
            "presentation": { "reveal": "always", "panel": "shared", "clear": true },
            "problemMatcher": {
                "owner": "swiftc",
                "fileLocation": ["autoDetect", "${workspaceFolder}"],
                "pattern": {
                    "regexp": "^(.*?):(\\d+):(\\d+):\\s+(error|warning):\\s+(.*)$",
                    "file": 1, "line": 2, "column": 3, "severity": 4, "message": 5
                }
            }
        }
    ]
}

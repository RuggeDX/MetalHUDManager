{
    // Play button (Code Runner) in the editor title bar:
    // - on a script in scripts/ (dev.sh, build-app.sh, make-dmg.sh): runs that script
    // - on a Swift file: starts the live dev build
    "code-runner.runInTerminal": true,
    "code-runner.saveFileBeforeRun": true,
    "code-runner.showRunIconInEditorTitleMenu": true,
    "code-runner.executorMap": {
        "shellscript": "\"$fullFileName\"",
        "swift": "cd $workspaceRoot && scripts/dev.sh"
    }
}
